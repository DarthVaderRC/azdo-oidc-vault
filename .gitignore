# macOS Finder metadata. Never useful in a repository.
.DS_Store

# Terraform working files and state.
.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
crash.log
tfplan

# Your own values. example.tfvars carries the placeholders and is committed.
*.tfvars
!example.tfvars

# State configuration is local: copy terraform/backend.tf.example to backend.tf.
terraform/backend.tf

# The presenter's own runbook: personal credentials workflow, window layout and
# real identifiers. The published guide is docs/DEMONSTRATING.md.
DEMO_RUNBOOK.md

# Vault presales design system, and the deck built from it. Internal, licensed
# fonts and brand artwork, deliberately not committed.
design/
presentation/
