# ${display_name}
#
# Generated by Terraform from pipelines/pipeline.yml.tftpl.
# Do not edit in Azure Repos: the next apply will overwrite it.
#
# The Vault token and the AWS credentials never leave the task that creates
# them. There is deliberately no task.setvariable and no isOutput.

trigger: none
pr: none

pool:
  vmImage: ubuntu-latest

jobs:
  - job: zsp
    displayName: '${display_name}'
    timeoutInMinutes: 15
    steps:
      - checkout: self
        displayName: 'Check out the POC repository'

%{ if token_method == "azurecli" || token_method == "both" ~}
      - task: AzureCLI@2
        displayName: 'Vault flow, ID token from the Azure CLI task'
%{ if token_method == "both" ~}
        continueOnError: true
%{ endif ~}
        inputs:
          azureSubscription: '${sc_name}'
          scriptType: bash
          scriptLocation: inlineScript
          addSpnToEnvironment: true
          inlineScript: |
            set -eo pipefail
            # addSpnToEnvironment exposes the federated assertion. Older agents
            # expose it as AZURE_FEDERATED_TOKEN instead of idToken.
            ID_TOKEN="$idToken"
            if [ -z "$ID_TOKEN" ]; then ID_TOKEN="$AZURE_FEDERATED_TOKEN"; fi
            export ID_TOKEN
            bash "$(Build.SourcesDirectory)/pipelines/vault-zsp.sh"
        env:
          MODE: '${mode}'
          VAULT_ADDR: '${vault_addr}'
          VAULT_NAMESPACE: '${vault_namespace}'
          VAULT_JWT_PATH: '${vault_jwt_path}'
          VAULT_ROLE: '${vault_role}'
          VAULT_AWS_PATH: '${vault_aws_path}'
          NEGATIVE_ROLE: '${negative_role}'
          NEGATIVE_SUBJECT: '${negative_subject}'
          AWS_DEFAULT_REGION: '${aws_region}'
          DEMO: '${demo}'
%{ endif ~}
%{ if token_method == "rest" ~}
      # The OidcToken API refuses to mint a token for a service connection the
      # job has not referenced: "There is no explicit reference to service
      # connection <id> from current stage". The authorised set is computed
      # from task inputs when the job is queued, so a task that never executes
      # still declares it. This task exists only to make that declaration.
      #
      # It cannot be allowed to run. AzureCLI@2 signs in and then selects the
      # subscription, and the managed identity deliberately holds no role
      # assignment, so the selection fails. That failure is the evidence for
      # choosing this path in the first place.
      - task: AzureCLI@2
        displayName: 'Declare the service connection (never runs)'
        condition: false
        inputs:
          azureSubscription: '${sc_name}'
          scriptType: bash
          scriptLocation: inlineScript
          inlineScript: 'true'
%{ endif ~}
%{ if token_method == "rest" || token_method == "both" ~}
      - task: Bash@3
        displayName: 'Vault flow, ID token from the OidcToken REST API'
        inputs:
          targetType: inline
          script: |
            set -eo pipefail
            # This path never invokes the Azure CLI, so it does not depend on
            # the managed identity holding any Azure role assignment.
            URL="$(System.CollectionUri)$(System.TeamProjectId)/_apis/distributedtask/hubs/build/plans/$(System.PlanId)/jobs/$(System.JobId)/oidctoken?serviceConnectionId=${sc_id}&api-version=7.1-preview.1"
            RESP="$(curl -sS -X POST \
              -H "Authorization: Bearer $SYSTEM_ACCESSTOKEN" \
              -H 'Content-Type: application/json' \
              -d '{}' "$URL")"
            ID_TOKEN="$(printf '%s' "$RESP" | jq -r '.oidcToken // empty')"
            if [ -z "$ID_TOKEN" ]; then
              echo "the OidcToken API returned no token"
              printf '%s' "$RESP" | head -c 400
              exit 1
            fi
            export ID_TOKEN
            bash "$(Build.SourcesDirectory)/pipelines/vault-zsp.sh"
        env:
          SYSTEM_ACCESSTOKEN: $(System.AccessToken)
          MODE: '${mode}'
          VAULT_ADDR: '${vault_addr}'
          VAULT_NAMESPACE: '${vault_namespace}'
          VAULT_JWT_PATH: '${vault_jwt_path}'
          VAULT_ROLE: '${vault_role}'
          VAULT_AWS_PATH: '${vault_aws_path}'
          NEGATIVE_ROLE: '${negative_role}'
          NEGATIVE_SUBJECT: '${negative_subject}'
          AWS_DEFAULT_REGION: '${aws_region}'
          DEMO: '${demo}'
%{ endif ~}
